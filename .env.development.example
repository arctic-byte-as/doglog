# Copy into .env.local after provisioning a separate Supabase development project.
# Never use production database credentials for development or Preview.
DATABASE_URL="postgresql://postgres.DEVELOPMENT_PROJECT_REF:DEVELOPMENT_DB_PASSWORD@DEVELOPMENT_POOLER_HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.DEVELOPMENT_PROJECT_REF:DEVELOPMENT_DB_PASSWORD@DEVELOPMENT_POOLER_HOST:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://DEVELOPMENT_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="DEVELOPMENT_PUBLISHABLE_KEY"
SUPABASE_SECRET_KEY="DEVELOPMENT_SECRET_KEY"
SUPABASE_STORAGE_DOG_IMAGES_BUCKET="dog-profile-images"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ADMIN_EMAILS="admin@example.test"
# Leave empty until a separate test email key and sender are available.
RESEND_API_KEY=""
DOGLOG_EMAIL_FROM="Doglog Development <onboarding@resend.dev>"
