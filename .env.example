# Doglog environment template.
# Copy values into .env locally and into Vercel Project Settings > Environment Variables.
# Never put real secrets in this file.

# Supabase + Prisma
# Latest Supabase Prisma guidance recommends a dedicated "prisma" database user.
# Create it in Supabase SQL Editor before using these URLs; see docs/SUPABASE_SEEDING.md.

# App runtime connection for Vercel/serverless.
# Use Supabase Connect > Transaction pooler URI, change the DB user to prisma.PROJECT_REF,
# use the Prisma role password, and keep ?pgbouncer=true for transaction-pooler compatibility.
DATABASE_URL="postgresql://prisma.PROJECT_REF:PRISMA_DB_PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma/database setup connection.
# Use Supabase Connect > Session pooler URI on port 5432, change the DB user to prisma.PROJECT_REF,
# and use the same Prisma role password. Direct connection can also work if your network supports it.
DIRECT_URL="postgresql://prisma.PROJECT_REF:PRISMA_DB_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres"

# Local SQLite seed source used only by the export script and SQLite schema validation.
SQLITE_DATABASE_URL="file:./dev.db"
SQLITE_SEED_DB="prisma/dev.db"
SEED_EXPORT_DIR="exports/supabase"

# NextAuth / email login.
# Production value must be your deployed site origin, with no trailing slash.
NEXTAUTH_URL="https://your-vercel-domain.vercel.app"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
ADMIN_EMAILS="admin@example.com"

# SMTP provider for magic-link email.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
EMAIL_FROM="Doglog <no-reply@example.com>"
