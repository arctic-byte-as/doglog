# Doglog environment template.
# Copy values into .env locally and into Vercel Project Settings > Environment Variables.
# Never put real secrets in this file.

# Supabase Postgres runtime connection for the app.
# Recommended for Vercel/serverless: Supabase Transaction pooler URI.
# Add ?pgbouncer=true if your Prisma/Supavisor connection reports prepared statement errors.
POSTGRES_DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Postgres direct connection for Prisma CLI/database setup commands.
# Use the Direct connection URI from Supabase. This is used by db:prod:baseline and seed:import:supabase.
DIRECT_URL="postgresql://postgres:DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Local SQLite seed source used only by the export script and SQLite schema validation.
DATABASE_URL="file:./dev.db"
SQLITE_SEED_DB="prisma/dev.db"
SEED_EXPORT_DIR="exports/supabase"

# NextAuth / email login.
# Production value must be your deployed site origin, with no trailing slash.
NEXTAUTH_URL="https://your-vercel-domain.vercel.app"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
ADMIN_EMAILS="admin@example.com"

# SMTP provider for magic-link email.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
EMAIL_FROM="Doglog <no-reply@example.com>"
