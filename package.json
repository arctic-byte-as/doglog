{
  "name": "doglog",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "seed": "node prisma/seed.js",
    "seed:export:supabase": "node scripts/export-supabase-seed.js",
    "db:prod:baseline": "prisma db execute --url \"$DIRECT_URL\" --file prisma/migrations/20260530195500_supabase_baseline/migration.sql",
    "seed:import:supabase": "prisma db execute --url \"$DIRECT_URL\" --file exports/supabase/seed.sql",
    "auth:set-password": "node scripts/set-user-password.js",
    "prisma:validate:sqlite": "prisma validate --schema prisma/schema.sqlite.prisma",
    "prisma:validate:prod": "prisma validate --schema prisma/schema.prisma",
    "lint": "next lint"
  },
  "dependencies": {
    "@prisma/client": "5.15.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.2",
    "@types/react": "18.3.4",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.35",
    "prisma": "5.15.0",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.3"
  }
}
