generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Trainer {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  dogs      Dog[]
}

model Customer {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  dogs      Dog[]
  serviceAccess CustomerServiceAccess[]
}

model CustomerServiceAccess {
  id         String   @id @default(uuid())
  serviceKey String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String

  @@unique([customerId, serviceKey])
}

model Dog {
  id            String         @id @default(uuid())
  name          String
  age           String
  breed         String
  status        String
  owner         String
  lastIncident  String?
  profileImageUrl String?
  trainer       Trainer        @relation(fields: [trainerId], references: [id])
  trainerId     String
  customer      Customer?      @relation(fields: [customerId], references: [id])
  customerId    String?
  observations  Observation[]
  consultations Consultation[]
  serviceSessions ServiceSession[]
}

model Observation {
  id       String   @id @default(uuid())
  category String
  severity String
  trigger  String
  notes    String
  loggedAt DateTime @default(now())
  dog      Dog      @relation(fields: [dogId], references: [id])
  dogId    String
}

model Consultation {
  id                 String   @id @default(uuid())
  date               DateTime
  focus              String
  outcome            String
  generalDescription String?
  dogBreed           String?
  learningHistory    String?
  situation          String?
  nutrition          String?
  health             String?
  hormoneAnalysis    String?
  activation         String?
  stimulusAnalysis   String?
  prescribedPlan     String?
  dog                Dog      @relation(fields: [dogId], references: [id])
  dogId              String
}

model ServiceSession {
  id                 String   @id @default(uuid())
  serviceKey         String
  date               DateTime
  focus              String
  outcome            String
  generalDescription String?
  dogBreed           String?
  learningHistory    String?
  situation          String?
  nutrition          String?
  health             String?
  hormoneAnalysis    String?
  activation         String?
  stimulusAnalysis   String?
  prescribedPlan     String?
  dog                Dog      @relation(fields: [dogId], references: [id])
  dogId              String
}

/// Legacy app identity model used for authorization during the Supabase Auth migration.
model User {
  id             String    @id @default(cuid())
  supabaseAuthId String?   @unique
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  passwordHash   String?
  role           String    @default("TRAINER")
  accounts       Account[]
  sessions       Session[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId])
  @@index([expires])
}

model AppContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
